# Copy to .dev.vars for wrangler dev. Keep real credentials out of Git.

# Test mode
APP_ENV=development
APP_BASE_URL=http://localhost:8787
INTEGRATION_MODE=mock
ALLOW_IMPERSONATION=true
MFA_REQUIRED_ROLES=
LMS_URL=
LMS_TOKEN=
EASEBUZZ_ENV=test
EASEBUZZ_KEY=
EASEBUZZ_SALT=

# Production mode
# Use these settings in the production server environment with its own secrets.
# Set LMS_URL and LMS_TOKEN after the client supplies the live LMS details.
# APP_ENV=production
# APP_BASE_URL=https://crm.laboffuture.com
# INTEGRATION_MODE=auto
# ALLOW_IMPERSONATION=false
# MFA_REQUIRED_ROLES="System Administrator,Management"
# LMS_URL=
# LMS_TOKEN=
# EASEBUZZ_ENV=prod
# EASEBUZZ_KEY=
# EASEBUZZ_SALT=

# Shared settings
PAYMENTS_INR_PROVIDER=easebuzz
JWT_SECRET=dev-only-change-me-32-chars-minimum!!
WEBSITE_FORM_SECRET=dev-website-secret
META_APP_SECRET=dev-meta-app-secret
META_VERIFY_TOKEN=dev-meta-verify
META_PAGE_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=dev-wa-app-secret
WHATSAPP_VERIFY_TOKEN=dev-wa-verify
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_WEBHOOK_TOKEN=dev-exotel-token
TELR_AUTH_KEY=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-razorpay-webhook
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
GCAL_SERVICE_ACCOUNT_JSON=
